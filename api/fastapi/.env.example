# FastAPI Backend Environment Variables
OPENAI_API_KEY=sk_...
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://terraiq:terraiqpass@localhost:5432/terraiqdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BROKER_URL=kafka:9092

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=terraiqpass

# Qdrant
QDRANT_URL=http://localhost:6333

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=terraiq
CLICKHOUSE_PASSWORD=terraiqpass
CLICKHOUSE_DB=telemetry

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Stripe SaaS Configuration
STRIPE_API_KEY=sk_test_mock_secret_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret
STRIPE_START_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Competitor Intelligence (ShadowNet)
COMPETITOR_INTEL_API_URL=https://api.example.com/competitor
COMPETITOR_INTEL_API_KEY=sk_...
COMPETITOR_INTEL_TIMEOUT_SECONDS=10

# Market Price Ingestion
MARKET_PRICE_API_URL=https://api.example.com/market
MARKET_PRICE_API_KEY=sk_...
MARKET_PRICE_TIMEOUT_SECONDS=10

# Frontend URLs
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://terraiq.me,https://www.terraiq.me

# Image Upload
MAX_IMAGE_UPLOAD_BYTES=5242880

# AgriNexus.Law — compliance agent document search
AGRINEXUS_LAW_BASE_URL=https://www.agrinexuslaw.com
