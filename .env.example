# TerraIQ Environment Configuration

# 1. AI Models (Required for LangGraph Agents)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 2. Database Configurations (Auto-configured for Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=terraiqpass

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000

KAFKA_BROKER_URL=localhost:9092

# Web / API
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://terraiq.me,https://www.terraiq.me
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin
TERRAIQ_ADMIN_USER=admin
TERRAIQ_ADMIN_PASSWORD=change_me

# Payments
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Uploads
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MAX_IMAGE_UPLOAD_BYTES=5242880
